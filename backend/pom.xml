<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.formoura</groupId>
    <artifactId>formoura-enterprise-ecommerce</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Formoura Enterprise E-Commerce</name>
    <description>Enterprise E-Commerce Platform using Spring Boot Microservices</description>

    <!-- ===================== Modules ===================== -->

    <modules>

        <!-- Common Modules -->
        <module>common-core</module>
        <module>common-security</module>
        <module>common-swagger</module>
        <module>common-exception</module>

        <!-- Infrastructure -->
        <!--<module>config-server</module>-->
        <module>discovery-service</module>
        <module>api-gateway</module>

        <!-- Business Services -->
        <!--<module>auth-service</module>
        <module>user-service</module>
        <module>product-service</module>
        <module>category-service</module>
        <module>inventory-service</module>
        <module>cart-service</module>
        <module>wishlist-service</module>
        <module>coupon-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>gst-service</module>
        <module>notification-service</module>
        <module>report-service</module>
        <module>search-service</module>
        <module>admin-service</module>
        <module>hr-service</module>
        <module>audit-service</module>-->

    </modules>

    <!-- ===================== Properties ===================== -->

    <properties>

        <java.version>21</java.version>

        <spring.boot.version>3.5.3</spring.boot.version>

        <spring.cloud.version>2025.0.0</spring.cloud.version>

        <mapstruct.version>1.6.3</mapstruct.version>

        <lombok.version>1.18.38</lombok.version>

        <jjwt.version>0.12.6</jjwt.version>

        <springdoc.version>2.8.9</springdoc.version>

        <maven.compiler.source>21</maven.compiler.source>

        <maven.compiler.target>21</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    <!-- ===================== Dependency Management ===================== -->

    <dependencyManagement>

        <dependencies>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <!-- ===================== Common Dependencies ===================== -->

    <dependencies>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!-- ===================== Build ===================== -->

    <build>

        <pluginManagement>

            <plugins>

                <!-- Spring Boot -->
                <plugin>

                    <groupId>org.springframework.boot</groupId>

                    <artifactId>spring-boot-maven-plugin</artifactId>

                </plugin>

                <!-- Maven Compiler -->
                <plugin>

                    <groupId>org.apache.maven.plugins</groupId>

                    <artifactId>maven-compiler-plugin</artifactId>

                    <version>3.13.0</version>

                    <configuration>

                        <source>${java.version}</source>

                        <target>${java.version}</target>

                        <annotationProcessorPaths>

                            <path>

                                <groupId>org.projectlombok</groupId>

                                <artifactId>lombok</artifactId>

                                <version>${lombok.version}</version>

                            </path>

                        </annotationProcessorPaths>

                    </configuration>

                </plugin>

                <!-- Surefire -->

                <plugin>

                    <groupId>org.apache.maven.plugins</groupId>

                    <artifactId>maven-surefire-plugin</artifactId>

                    <version>3.5.2</version>

                </plugin>

            </plugins>

        </pluginManagement>

    </build>

</project>